import math.{floor}

fun binary_search(list, item) {
  let n = #list
  let l = 0, r = n - 1

  while l <= r {
    let m = l  + floor((r - l) / 2)
    let _item = list[m]
    if item > _item
        l = m + 1
    else if item < _item
        r = m - 1
    else
        return m
  }

  return nil
}


res = binary_search([1, 2, 3, 4, 5, 6], 3)

println(res)
