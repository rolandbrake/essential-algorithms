// An algorithm is a finite sequence of well-defined instructions, 
// typically used to solve a class of specific problems or to perform a computation.


// this file contains some simple algorithms to demostrate the concept of 
// algorithms and how they can be implemented in PI.


// 1. A simple algorithm to find the maximum value in a list of numbers.
// this algorithm has a linear time complexity of O(n) and its the most
// efficient way to find the maximum value in a list of numbers.
fun find_max(_list) {
    let max_value = _list[0]

    for i in range(1, #_list) {
        if _list[i] > max_value {
            max_value = _list[i]
        }
    }

    return max_value
}

// 2. A simple algorithm to return countdown from a given number to zero.
fun countdown(n) {
    let steps = []
    while n > 0 {
        steps.append(n)
        n = n - 1
    }

    steps.append(0)

    return steps
}

// 3. A simple algorithm to calculate the sum of all elements in a list of numbers.
fun list_sum(_list) {
    let sum = 0
    
    for i in range(#_list) {
        sum = sum + _list[i]
    }

    return sum
}


let items = [8, 3, 12, 5, 2, 9]
println("max value in the list: " + find_max(items))
println("countdown from 5 to 0: " + countdown(5))
println("sum of the values: " + list_sum(items))
